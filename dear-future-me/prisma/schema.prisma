generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum MediaType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LETTER
}

enum MemoryStatus {
  PENDING
  READY
  REJECTED
}

enum ScanStatus {
  NOT_SCANNED
  CLEAN
  INFECTED
}

enum CapsuleStatus {
  DRAFT
  LOCKED
  SCHEDULED
  AVAILABLE
  OPENED
  CANCELLED
  FAILED
}

enum CapsuleVisibility {
  PRIVATE
  SHARED
  FAMILY
}

enum CapsuleKind {
  STANDARD
  FUTURE_SELF
}

enum RecipientPermission {
  VIEW
  CONTRIBUTE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum JobType {
  RELEASE
  REMINDER
}

enum JobStatus {
  PENDING
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  DEAD
  CANCELLED
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum NotificationType {
  CAPSULE_CREATED
  CAPSULE_LOCKED
  CAPSULE_REMINDER
  CAPSULE_UNLOCKED
  CAPSULE_INVITE
  CAPSULE_CONTRIBUTION
  STORAGE_WARNING
}

enum EmailStatus {
  NONE
  PENDING
  SENDING
  SENT
  FAILED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum AnswerPhase {
  THEN
  NOW
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  emailVerifiedAt   DateTime? @map("email_verified_at")
  passwordHash      String?   @map("password_hash")
  avatarKey         String?   @map("avatar_key")
  timezone          String    @default("UTC")
  dateOfBirth       DateTime? @map("date_of_birth") @db.Date
  role              Role      @default(USER)
  sessionVersion    Int       @default(0) @map("session_version")
  notificationPrefs Json      @default("{}") @map("notification_prefs")
  aiConsentAt       DateTime? @map("ai_consent_at")
  lastActiveAt      DateTime? @map("last_active_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  subscription  Subscription?
  memories      Memory[]
  albums        Album[]
  categories    Category[]
  capsules      Capsule[]             @relation("CapsuleCreator")
  recipientOf   CapsuleRecipient[]
  contributions CapsuleContribution[]
  answers       CapsuleAnswer[]
  notifications Notification[]
  tokens        Token[]
  auditLogs     AuditLog[]

  @@index([createdAt])
  @@index([lastActiveAt])
  @@map("users")
}

model Token {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      TokenType
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("tokens")
}

/// Plan limits and display prices live in data, not in business logic.
model Plan {
  id                String  @id
  name              String
  description       String
  storageLimitBytes BigInt  @map("storage_limit_bytes")
  maxActiveCapsules Int?    @map("max_active_capsules")
  maxFileSizeBytes  BigInt  @map("max_file_size_bytes")
  maxRecipients     Int     @map("max_recipients")
  features          Json    @default("{}")
  highlights        Json    @default("[]")
  priceCentsMonthly Int     @default(0) @map("price_cents_monthly")
  currency          String  @default("usd")
  stripePriceEnv    String? @map("stripe_price_env")
  sortOrder         Int     @default(0) @map("sort_order")
  isPublic          Boolean @default(true) @map("is_public")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String             @unique @map("user_id")
  planId           String             @map("plan_id")
  status           SubscriptionStatus @default(ACTIVE)
  billingReference String?            @map("billing_reference")
  externalId       String?            @unique @map("external_id")
  currentPeriodEnd DateTime?          @map("current_period_end")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([planId, status])
  @@map("subscriptions")
}

model Category {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  memories Memory[]
  capsules Capsule[]

  @@unique([userId, name])
  @@map("categories")
}

model Memory {
  id               String       @id @default(cuid())
  userId           String       @map("user_id")
  title            String?
  description      String?
  mediaType        MediaType    @map("media_type")
  status           MemoryStatus @default(PENDING)
  scanStatus       ScanStatus   @default(NOT_SCANNED) @map("scan_status")
  /// false for content sealed directly into a capsule: it never appears in the
  /// vault and is only readable through a released capsule.
  inVault          Boolean      @default(true) @map("in_vault")
  storageKey       String?      @unique @map("storage_key")
  thumbnailKey     String?      @map("thumbnail_key")
  uploadId         String?      @map("upload_id")
  originalFilename String?      @map("original_filename")
  fileSize         BigInt       @default(0) @map("file_size")
  mimeType         String?      @map("mime_type")
  /// Body of a written letter (mediaType LETTER).
  content          String?
  categoryId       String?      @map("category_id")
  tags             String[]     @default([])
  captureDate      DateTime?    @map("capture_date")
  uploadedAt       DateTime     @default(now()) @map("uploaded_at")
  metadata         Json         @default("{}")

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  albums        AlbumMemory[]
  capsules      CapsuleMemory[]
  contributions CapsuleContribution[]

  @@index([userId, inVault, status, captureDate])
  @@index([userId, mediaType])
  @@index([tags], type: Gin)
  @@map("memories")
}

model Album {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  memories AlbumMemory[]

  @@index([userId])
  @@map("albums")
}

model AlbumMemory {
  albumId  String   @map("album_id")
  memoryId String   @map("memory_id")
  addedAt  DateTime @default(now()) @map("added_at")

  album  Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  memory Memory @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@id([albumId, memoryId])
  @@index([memoryId])
  @@map("album_memories")
}

model Capsule {
  id                 String            @id @default(cuid())
  creatorId          String            @map("creator_id")
  kind               CapsuleKind       @default(STANDARD)
  title              String
  description        String?
  message            String?
  categoryId         String?           @map("category_id")
  coverMemoryId      String?           @map("cover_memory_id")
  theme              String            @default("midnight")
  unlockAt           DateTime?         @map("unlock_at")
  timezone           String            @default("UTC")
  /// How the date was chosen (preset / custom / milestone), for display.
  schedule           Json?
  status             CapsuleStatus     @default(DRAFT)
  visibility         CapsuleVisibility @default(PRIVATE)
  includeSelf        Boolean           @default(true) @map("include_self")
  allowContributions Boolean           @default(false) @map("allow_contributions")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  lockedAt           DateTime?         @map("locked_at")
  releasedAt         DateTime?         @map("released_at")
  openedAt           DateTime?         @map("opened_at")

  creator       User                  @relation("CapsuleCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  category      Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  memories      CapsuleMemory[]
  recipients    CapsuleRecipient[]
  contributions CapsuleContribution[]
  answers       CapsuleAnswer[]
  jobs          ScheduledJob[]
  notifications Notification[]

  @@index([creatorId, status])
  @@index([status, unlockAt])
  @@map("capsules")
}

model CapsuleMemory {
  id           String @id @default(cuid())
  capsuleId    String @map("capsule_id")
  memoryId     String @map("memory_id")
  displayOrder Int    @default(0) @map("display_order")

  capsule Capsule @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  memory  Memory  @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([capsuleId, memoryId])
  @@index([memoryId])
  @@map("capsule_memories")
}

model CapsuleRecipient {
  id               String              @id @default(cuid())
  capsuleId        String              @map("capsule_id")
  userId           String?             @map("user_id")
  email            String
  recipientName    String?             @map("recipient_name")
  permission       RecipientPermission @default(VIEW)
  invitationStatus InvitationStatus    @default(PENDING) @map("invitation_status")
  inviteTokenHash  String?             @unique @map("invite_token_hash")
  invitedAt        DateTime?           @map("invited_at")
  acceptedAt       DateTime?           @map("accepted_at")
  openedAt         DateTime?           @map("opened_at")
  /// Claimed before the unlock email is sent so a retried job can't send twice.
  releaseNotifiedAt DateTime?          @map("release_notified_at")
  createdAt        DateTime            @default(now()) @map("created_at")

  capsule Capsule @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([capsuleId, email])
  @@index([userId])
  @@index([email])
  @@map("capsule_recipients")
}

model CapsuleContribution {
  id            String   @id @default(cuid())
  capsuleId     String   @map("capsule_id")
  contributorId String   @map("contributor_id")
  memoryId      String   @map("memory_id")
  createdAt     DateTime @default(now()) @map("created_at")

  capsule     Capsule @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  contributor User    @relation(fields: [contributorId], references: [id], onDelete: Cascade)
  memory      Memory  @relation(fields: [memoryId], references: [id], onDelete: Cascade)

  @@unique([capsuleId, memoryId])
  @@index([contributorId])
  @@map("capsule_contributions")
}

/// Guided-question answers. THEN is written when the capsule is created,
/// NOW when it is opened, which powers the past-versus-present comparison.
model CapsuleAnswer {
  id        String      @id @default(cuid())
  capsuleId String      @map("capsule_id")
  userId    String      @map("user_id")
  promptKey String      @map("prompt_key")
  prompt    String
  answer    String
  phase     AnswerPhase
  createdAt DateTime    @default(now()) @map("created_at")

  capsule Capsule @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([capsuleId, userId, promptKey, phase])
  @@map("capsule_answers")
}

model Notification {
  id          String           @id @default(cuid())
  userId      String           @map("user_id")
  capsuleId   String?          @map("capsule_id")
  type        NotificationType
  title       String
  body        String
  /// Makes creation idempotent: a retried job cannot notify twice.
  dedupeKey   String           @unique @map("dedupe_key")
  emailStatus EmailStatus      @default(NONE) @map("email_status")
  readAt      DateTime?        @map("read_at")
  deliveredAt DateTime?        @map("delivered_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  capsule Capsule? @relation(fields: [capsuleId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([emailStatus])
  @@map("notifications")
}

/// Postgres is the source of truth for what must run and when. Redis/BullMQ
/// only carries the execution; a sweeper re-enqueues anything Redis lost.
model ScheduledJob {
  id          String    @id @default(cuid())
  capsuleId   String    @map("capsule_id")
  type        JobType
  /// Distinguishes several jobs of one type (e.g. reminder offsets).
  variant     String    @default("")
  scheduledAt DateTime  @map("scheduled_at")
  status      JobStatus @default(PENDING) @map("job_status")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  capsule Capsule @relation(fields: [capsuleId], references: [id], onDelete: Cascade)

  @@unique([capsuleId, type, variant])
  @@index([status, scheduledAt])
  @@map("scheduled_jobs")
}

model EmailLog {
  id         String      @id @default(cuid())
  toEmail    String      @map("to_email")
  template   String
  subject    String
  status     EmailStatus
  providerId String?     @map("provider_id")
  error      String?
  createdAt  DateTime    @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([status])
  @@map("email_logs")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String
  resourceId String?  @map("resource_id")
  ip         String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([resourceId])
  @@map("audit_logs")
}
