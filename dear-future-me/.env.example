# ── Core ────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
# openssl rand -base64 32
AUTH_SECRET=
DATABASE_URL=postgresql://dfm:dfm@localhost:5432/dfm
REDIS_URL=redis://localhost:6379

# ── Google sign-in (optional; button is hidden when unset) ──────────────
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ── Media storage ───────────────────────────────────────────────────────
# "local" stores files on disk under STORAGE_LOCAL_DIR (development only).
# "s3" works with Cloudflare R2 or AWS S3 (private bucket, signed URLs).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/storage
# openssl rand -base64 32 — signs local-driver URLs
STORAGE_SIGNING_SECRET=
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Email ───────────────────────────────────────────────────────────────
# Without RESEND_API_KEY, emails are written to .data/outbox (development).
RESEND_API_KEY=
EMAIL_FROM="Dear Future Me <hello@example.com>"

# ── Billing (optional; upgrade buttons are disabled when unset) ─────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PERSONAL=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_FAMILY=

# ── AI (optional; AI features are hidden when unset) ────────────────────
ANTHROPIC_API_KEY=

# ── Monitoring (optional) ───────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ── Bootstrap ───────────────────────────────────────────────────────────
# Email that `npm run db:seed` promotes to SUPER_ADMIN (must already be registered).
SUPER_ADMIN_EMAIL=

# ── Capsule sealing keys (generate with `npm run keys:generate`) ────────
# Public key: needed by the web app and the worker to seal capsules.
SEALING_PUBLIC_KEY=
# Private key: set this ONLY on the release worker / key service, never on
# the web app. Losing it makes every locked capsule unrecoverable.
KEY_RELEASE_PRIVATE_KEY=
